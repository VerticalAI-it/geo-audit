# GEO Audit · Fase B — variabili d'ambiente richieste
# Copia in .env e compila con i tuoi valori (non committare mai .env)

# Supabase — Project Settings > API
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Nota: SUPABASE_ANON_KEY è usata anche lato client (login/auth callback) —
# è la chiave pubblica progettata per essere esposta, protetta dalle RLS.

# Resend — resend.com > API Keys
RESEND_API_KEY=re_...

# Email mittente (dominio verificato su Resend)
FROM_EMAIL=noreply@verticalai.it

# URL pubblico del deploy (senza slash finale)
SITE_URL=https://geo-audit.vercel.app

# Segreto per proteggere l'endpoint /api/cron (stringa casuale, min 32 caratteri)
CRON_SECRET=cambia-questo-con-una-stringa-casuale-sicura
