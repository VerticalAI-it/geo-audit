# Database — Supabase
# Trovalo su: Supabase Dashboard → Project Settings → Database → Connection string → URI
# Usa la stringa "Transaction pooler" (porta 6543) per ambienti serverless,
# oppure la "Direct connection" (porta 5432) per un server Node.js persistente.
DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# Server
PORT=3000
BASE_URL=http://localhost:3000

# Stripe
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Admin
ADMIN_TOKEN=change_me_to_a_long_random_string
